# Copy this file to .env and fill in your keys before going live.
# The app works fully offline without any keys set.

# ── AI/ML API (primary LLM for hedging scoring + spin-vs-reality) ──────────
# Sign up: https://aimlapi.com  |  Promo: see claude_instructions.md
AIML_API_KEY=
AIML_MODEL=gpt-4o-mini          # or gpt-4o, claude-3-haiku, etc.

# ── Featherless AI (cheap inference for bulk transcript summarization) ──────
# Sign up: https://featherless.ai  |  Promo: WEBDATA26
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=mistralai/Mistral-7B-Instruct-v0.2

# ── Cognee (knowledge-graph memory for cross-quarter diffs) ────────────────
# Sign up: https://cognee.ai  |  Promo: WEBDATA26
COGNEE_API_KEY=

# ── Bright Data (live transcript + signal scraping) ────────────────────────
# Sign up: https://brightdata.com  |  Promo: unlocked
BRIGHTDATA_API_KEY=
